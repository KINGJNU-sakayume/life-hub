{
  "name": "life-hub-api",
  "main": "src/server/index.js",
  "compatibility_date": "2026-11-01",
  // Required for OAuth Client ID Metadata Documents (SSRF protection on outbound metadata fetches).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  // Hourly Spotify collection for potcast (does nothing unless Spotify is configured and linked).
  "triggers": { "crons": ["23 * * * *"] },
  "vars": {
    // Exact public origin of this Worker, no trailing slash. The MCP connector URL is <origin>/mcp.
    "HUB_PUBLIC_ORIGIN": "REPLACE_WITH_YOUR_PUBLIC_ORIGIN",
    // Optional: PALATE's exact OAuth redirect URI (its app URL). Empty disables the PALATE inbox API.
    "HUB_PALATE_REDIRECT_URI": "REPLACE_WITH_YOUR_PALATE_REDIRECT_URI",
    // Optional: 켜켜이's exact OAuth redirect URI (its app URL). Empty disables the 켜켜이 inbox API.
    "HUB_KYEOKYEOI_REDIRECT_URI": "REPLACE_WITH_YOUR_KYEOKYEOI_REDIRECT_URI",
    // Optional: potcast's Life Hub callback page URL. Empty disables the potcast inbox API.
    "HUB_POTCAST_REDIRECT_URI": "REPLACE_WITH_YOUR_POTCAST_REDIRECT_URI",
    // Optional: 업적 라이브러리's Life Hub callback page URL. Empty disables its inbox API.
    "HUB_ACHIEVEMENT_REDIRECT_URI": "REPLACE_WITH_YOUR_ACHIEVEMENT_REDIRECT_URI",
    // Optional: 책장 (letterbookxd)'s Life Hub callback page URL. Empty disables its inbox API.
    "HUB_LETTERBOOKXD_REDIRECT_URI": "REPLACE_WITH_YOUR_LETTERBOOKXD_REDIRECT_URI",
    // Optional: 역 도장깨기 (sub)'s Life Hub callback page URL. Empty disables its inbox API.
    "HUB_SUB_REDIRECT_URI": "REPLACE_WITH_YOUR_SUB_REDIRECT_URI",
    // Optional: AniMan's Life Hub callback page URL. Empty disables its inbox API.
    "HUB_ANIMAN_REDIRECT_URI": "REPLACE_WITH_YOUR_ANIMAN_REDIRECT_URI",
    // Optional: 일기 룰렛 (Diaryroulette)'s Life Hub callback page URL. Empty disables its inbox API.
    "HUB_DIARYROULETTE_REDIRECT_URI": "REPLACE_WITH_YOUR_DIARYROULETTE_REDIRECT_URI",
    // Optional: ELO Sorter's Life Hub callback page URL (a sync-only app: it keeps its session here, no inbox). Empty disables its sync API.
    "HUB_ELOSORTER_REDIRECT_URI": "REPLACE_WITH_YOUR_ELOSORTER_REDIRECT_URI",
    // Optional: Spotify app client ID (public, 32 hex) for the hourly potcast collection. Empty disables it.
    // Also needs the HUB_SPOTIFY_TOKEN_KEY secret (Cloudflare dashboard) and the redirect URI <origin>/spotify/callback in the Spotify app.
    "HUB_SPOTIFY_CLIENT_ID": "REPLACE_WITH_YOUR_SPOTIFY_CLIENT_ID"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-hub-private",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // OAuth clients, grants and hashed tokens (managed by @cloudflare/workers-oauth-provider).
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
